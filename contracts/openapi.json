            "title": "Evidence Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "root",
          "evidence_ids"
        ],
        "title": "PackageManagerHint"
      },
      "PlanStatus": {
        "type": "string",
        "enum": [
          "actionable",
