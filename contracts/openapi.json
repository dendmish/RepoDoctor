          "confidence",
          "origin",
          "evidence_ids",
          "suggested_action"
        ],
        "title": "Finding"
      },
      "GenerationInfo": {
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/GenerationMode"
          },
