{
  "openapi": "3.1.0",
  "info": {
    "title": "RepoDoctor API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Liveness and active configuration (no external calls)",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analyses": {
      "post": {
        "summary": "Analyze a public GitHub repository",
        "operationId": "create_analysis_api_v1_analyses_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Request Entity Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Gateway Timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analyses/{analysis_id}/diagnoses": {
      "post": {
        "summary": "Diagnose a pasted error log in the context of a stored analysis",
        "operationId": "create_diagnosis_api_v1_analyses__analysis_id__diagnoses_post",
        "parameters": [
          {
            "name": "analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Analysis Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DiagnosisRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiagnosisResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Gateway Timeout"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalysisRequest": {
        "properties": {
          "repo_url": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Repo Url"
          },
          "ref": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Ref"
          },
          "target": {
            "$ref": "#/components/schemas/TargetEnvironment"
          },
          "use_ai": {
            "type": "boolean",
            "title": "Use Ai",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "repo_url",
          "target"
        ],
        "title": "AnalysisRequest"
      },
      "AnalysisResponse": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version"
          },
          "analysis_id": {
            "type": "string",
            "title": "Analysis Id"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "expires_at": {
            "type": "string",
            "title": "Expires At"
          },
          "source_mode": {
            "$ref": "#/components/schemas/SourceMode"
          },
          "repository": {
            "$ref": "#/components/schemas/RepositoryInfo"
          },
          "target": {
            "$ref": "#/components/schemas/TargetEnvironment"
          },
          "facts": {
            "$ref": "#/components/schemas/RepositoryFacts"
          },
          "coverage": {
            "$ref": "#/components/schemas/Coverage"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "type": "array",
            "title": "Findings"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          },
          "run_plan": {
            "$ref": "#/components/schemas/RunPlan"
          },
          "generation": {
            "$ref": "#/components/schemas/GenerationInfo"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "analysis_id",
          "created_at",
          "expires_at",
          "source_mode",
          "repository",
          "target",
          "facts",
          "coverage",
          "findings",
          "evidence",
          "run_plan",
          "generation",
          "warnings"
        ],
        "title": "AnalysisResponse"
      },
      "Command": {
        "properties": {
          "shell": {
            "$ref": "#/components/schemas/Shell"
          },
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text"
          },
          "cwd": {
            "type": "string",
            "title": "Cwd"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "requires_review": {
            "type": "boolean",
            "title": "Requires Review"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "shell",
          "text",
          "cwd",
          "explanation",
          "requires_review"
        ],
        "title": "Command"
      },
      "Confidence": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "title": "Confidence"
      },
      "Coverage": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/CoverageStatus"
          },
          "tree_entries_seen": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Tree Entries Seen"
          },
          "files_selected": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Files Selected"
          },
          "files_read": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Files Read"
          },
          "bytes_read": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Bytes Read"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "tree_entries_seen",
          "files_selected",
          "files_read",
          "bytes_read",
          "limitations"
        ],
        "title": "Coverage"
      },
      "CoverageStatus": {
        "type": "string",
        "enum": [
          "complete",
          "partial"
        ],
        "title": "CoverageStatus"
      },
      "Dependency": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "constraint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Constraint"
          },
          "ecosystem": {
            "$ref": "#/components/schemas/Ecosystem"
          },
          "kind": {
            "$ref": "#/components/schemas/DependencyKind"
          },
          "manifest_path": {
            "type": "string",
            "title": "Manifest Path"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "constraint",
          "ecosystem",
          "kind",
          "manifest_path",
          "evidence_ids"
        ],
        "title": "Dependency"
      },
      "DependencyKind": {
        "type": "string",
        "enum": [
          "runtime",
          "dev",
          "optional"
        ],
        "title": "DependencyKind"
      },
      "DiagnosisCause": {
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "title": "Id"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "confidence": {
            "$ref": "#/components/schemas/Confidence"
          },
          "origin": {
            "$ref": "#/components/schemas/Origin"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence Ids"
          },
          "fixes": {
            "items": {
              "$ref": "#/components/schemas/RunStep"
            },
            "type": "array",
            "maxItems": 12,
            "title": "Fixes"
          },
          "verification": {
            "type": "string",
            "title": "Verification"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "explanation",
          "confidence",
          "origin",
          "evidence_ids",
          "fixes",
          "verification"
        ],
        "title": "DiagnosisCause"
      },
      "DiagnosisRequest": {
        "properties": {
          "log": {
            "type": "string",
            "maxLength": 30000,
            "minLength": 1,
            "title": "Log"
          },
          "command": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Command"
          },
          "use_ai": {
            "type": "boolean",
            "title": "Use Ai",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "log"
        ],
        "title": "DiagnosisRequest"
      },
      "DiagnosisResponse": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version"
          },
          "diagnosis_id": {
            "type": "string",
            "title": "Diagnosis Id"
          },
          "analysis_id": {
            "type": "string",
            "title": "Analysis Id"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "generation": {
            "$ref": "#/components/schemas/GenerationInfo"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "causes": {
            "items": {
              "$ref": "#/components/schemas/DiagnosisCause"
            },
            "type": "array",
            "maxItems": 5,
            "title": "Causes"
          },
          "questions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Questions"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "diagnosis_id",
          "analysis_id",
          "created_at",
          "generation",
          "summary",
          "causes",
          "questions",
          "evidence",
          "warnings"
        ],
        "title": "DiagnosisResponse"
      },
      "Ecosystem": {
        "type": "string",
        "enum": [
          "python",
          "node"
        ],
        "title": "Ecosystem"
      },
      "EntryPoint": {
        "properties": {
          "root": {
            "type": "string",
            "title": "Root"
          },
          "command_hint": {
            "type": "string",
            "minLength": 1,
            "title": "Command Hint"
          },
          "kind": {
            "$ref": "#/components/schemas/EntryPointKind"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "root",
          "command_hint",
          "kind",
          "evidence_ids"
        ],
        "title": "EntryPoint"
      },
      "EntryPointKind": {
        "type": "string",
        "enum": [
          "readme",
          "script",
          "module",
          "file"
        ],
        "title": "EntryPointKind"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable"
          },
          "details": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Details"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
