          "EMPTY_REPOSITORY",
          "PAYLOAD_TOO_LARGE",
          "UNSUPPORTED_REPOSITORY",
          "SERVER_BUSY",
          "GITHUB_RATE_LIMITED",
          "GITHUB_UNAVAILABLE",
          "ANALYSIS_TIMEOUT",
          "INTERNAL_ERROR",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED"
