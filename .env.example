# Copy to .env in the project root. Never commit .env or real keys.
# Variable names and safe defaults only (ARCHITECTURE.md section 12).

# development | test | production
APP_ENV=development
# fixture (offline synthetic repositories) | live (GitHub REST API)
REPOSITORY_MODE=fixture

# Optional: raises GitHub rate limits; sent only to https://api.github.com
GITHUB_TOKEN=
GITHUB_API_VERSION=2026-03-10

# gigachat (default) | openai. Missing credentials -> local rules, no vendor switching.
AI_PROVIDER=gigachat
# Authorization Key from GigaChat cabinet, Base64 value WITHOUT the "Basic " prefix.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Example for personal Freemium access; set the model available to your account.
GIGACHAT_MODEL=GigaChat-3-Ultra
# Optional PEM CA bundle, relative to project root or absolute. TLS is always verified.
GIGACHAT_CA_BUNDLE=

# Used only with AI_PROVIDER=openai; both values are required.
OPENAI_API_KEY=
OPENAI_MODEL=

AI_TIMEOUT_SECONDS=40
AI_MAX_OUTPUT_TOKENS=6000
ANALYSIS_TIMEOUT_SECONDS=85
DIAGNOSIS_TIMEOUT_SECONDS=45
STORE_TTL_SECONDS=1800
STORE_MAX_ITEMS=30
MAX_CONCURRENT_OPERATIONS=2

# Optional override; defaults to <project root>/fixtures
# FIXTURES_DIR=

# Optional legacy synthetic API stubs; default wiring uses real source/scanner/intelligence.
# Forbidden with APP_ENV=production.
USE_DEV_STUBS=false
